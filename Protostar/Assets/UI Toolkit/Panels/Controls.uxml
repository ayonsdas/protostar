            <ui:Label text="Right Click                                                 Rotate Camera" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/diffusion-regular.ttf?fileID=12800000&amp;guid=f760a940b7e6de640878ca886a4eb990&amp;type=3#diffusion-regular&quot;); font-size: 35px; -unity-text-outline-color: rgb(150, 162, 179); -unity-text-outline-width: 1px; color: rgb(150, 162, 179); margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 25px;"/>
