        <ui:Label text="Controls" style="font-size: 55px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/diffusion-regular.ttf?fileID=12800000&amp;guid=f760a940b7e6de640878ca886a4eb990&amp;type=3#diffusion-regular&quot;); -unity-font-style: bold; -unity-text-outline-width: 1px; color: rgb(150, 162, 179); margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px; -unity-text-outline-color: rgb(150, 162, 179); letter-spacing: 10px;"/>
