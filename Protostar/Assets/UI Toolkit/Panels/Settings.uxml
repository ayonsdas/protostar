<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Styles/background.uss?fileID=7433441132597879392&amp;guid=236f60b44536c5945b386979a2a7caa3&amp;type=3#background"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/toggle.uss?fileID=7433441132597879392&amp;guid=7953690aa0dcd9143aba92266de10fb2&amp;type=3#toggle"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/dropdowns.uss?fileID=7433441132597879392&amp;guid=93e3f89099b44e14a8496c119d34bd4e&amp;type=3#dropdowns"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/buttons.uss?fileID=7433441132597879392&amp;guid=918d511739c223b43938892711387e22&amp;type=3#buttons"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/slider.uss?fileID=7433441132597879392&amp;guid=10835539878777e4db1387771d891999&amp;type=3#slider"/>
    <ui:VisualElement name="SettingsContainer" class="settings-background">
        <ui:Label text="Settings" name="Title" style="-unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/diffusion-regular.ttf?fileID=12800000&amp;guid=f760a940b7e6de640878ca886a4eb990&amp;type=3#diffusion-regular&quot;); font-size: 55px; color: rgb(150, 162, 179); padding-top: 0; padding-left: 0; padding-right: 0; padding-bottom: 0; margin-top: 20px; margin-right: 0; margin-bottom: 0; margin-left: 25px; letter-spacing: 10px;"/>
        <ui:Slider label="Master Volume: " value="100" high-value="100" tooltip="" fill="true" show-input-field="false" inverted="false" name="MasterVolumeSlider" class="settings-slider"/>
        <ui:Slider label="Mouse Sensitivity:" value="2.5" high-value="10" tooltip="" fill="true" show-input-field="false" inverted="false" name="MouseSensitivitySlider" low-value="0.01" class="settings-slider"/>
        <ui:Toggle label="Fullscreen:" name="FullscreenToggle" value="false" text="" style="font-size: 35px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/diffusion-regular.ttf?fileID=12800000&amp;guid=f760a940b7e6de640878ca886a4eb990&amp;type=3#diffusion-regular&quot;); color: rgb(150, 162, 179); margin-top: 25px; margin-right: 25px; margin-bottom: 25px; margin-left: 25px; letter-spacing: 10px;"/>
        <ui:DropdownField label="Resolution:" name="ResolutionDropdown" style="font-size: 35px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/diffusion-regular.ttf?fileID=12800000&amp;guid=f760a940b7e6de640878ca886a4eb990&amp;type=3#diffusion-regular&quot;); color: rgb(150, 162, 179); margin-top: 25px; margin-right: 25px; margin-bottom: 25px; margin-left: 25px; -unity-text-align: upper-left; letter-spacing: 10px;"/>
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row; align-items: auto; justify-content: space-around;">
            <ui:Button text="Back&#10;" name="BackButton" class="menu-button settings-button"/>
            <ui:Button text="Controls" name="ControlsButton" class="menu-button settings-button"/>
            <ui:Button text="Main Menu" name="MainMenuButton" class="menu-button settings-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
