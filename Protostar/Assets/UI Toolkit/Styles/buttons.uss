:root {
}

.menu-button {
    -unity-font-style: bold;
    font-size: 30px;
    background-color: rgb(234, 240, 216);
    color: rgb(89, 96, 112);
    -unity-text-outline-color: rgb(150, 162, 179);
    -unity-text-outline-width: 1px;
    letter-spacing: 10px;
    margin-top: 10px;
    margin-right: 30px;
    margin-bottom: 10px;
    margin-left: 30px;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-left-color: rgb(150, 162, 179);
    border-right-color: rgb(150, 162, 179);
    border-top-color: rgb(150, 162, 179);
    border-bottom-color: rgb(150, 162, 179);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.1s;
}

.mouse-mode .menu-button:hover {
    scale: 1.05;
    border-color: rgb(255, 215, 0);
}

.controller-mode .menu-button:focus {
    scale: 1.05;
    border-color: rgb(255, 215, 0);
}

.menu-button:active {
    background-color: rgb(238, 255, 204);
}

.credits-button {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/diffusion-regular.ttf?fileID=12800000&guid=f760a940b7e6de640878ca886a4eb990&type=3#diffusion-regular");
    -unity-font-style: bold;
    color: rgb(65, 58, 66);
    letter-spacing: 10px;
    -unity-text-outline-color: rgb(150, 162, 179);
    font-size: 30px;
    background-color: rgb(188, 188, 188);
    -unity-text-outline-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-top-width: 8px;
    border-right-width: 8px;
    border-bottom-width: 8px;
    border-left-width: 8px;
    padding-top: 10px;
    padding-right: 0;
    padding-bottom: 10px;
    padding-left: 0;
    margin-top: 83px;
    margin-right: 600px;
    margin-bottom: 25px;
    margin-left: 600px;
    -unity-text-align: middle-center;
}

.controls-return-button {
    margin-top: 10px;
    margin-right: 500px;
    margin-bottom: 20px;
    margin-left: 500px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/diffusion-regular.ttf?fileID=12800000&guid=f760a940b7e6de640878ca886a4eb990&type=3#diffusion-regular");
    color: rgb(65, 58, 66);
    -unity-text-outline-color: rgb(150, 162, 179);
    font-size: 30px;
    -unity-text-outline-width: 1px;
    border-left-color: rgb(150, 162, 179);
    border-right-color: rgb(150, 162, 179);
    border-top-color: rgb(150, 162, 179);
    border-bottom-color: rgb(150, 162, 179);
    border-top-width: 8px;
    border-right-width: 8px;
    border-bottom-width: 8px;
    border-left-width: 8px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    background-color: rgb(188, 188, 188);
}

.settings-button {
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/diffusion-regular.ttf?fileID=12800000&guid=f760a940b7e6de640878ca886a4eb990&type=3#diffusion-regular");
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 20px;
    margin-left: 10px;
    padding-right: 200px;
    padding-left: 200px;
    letter-spacing: 10px;
    color: rgb(65, 58, 66);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(150, 162, 179);
    -unity-font-style: bold;
    border-top-width: 8px;
    border-right-width: 8px;
    border-bottom-width: 8px;
    border-left-width: 8px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-left-color: rgb(150, 162, 179);
    border-right-color: rgb(150, 162, 179);
    border-top-color: rgb(150, 162, 179);
    border-bottom-color: rgb(150, 162, 179);
}
