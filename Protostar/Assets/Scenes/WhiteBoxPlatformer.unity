  m_Script: {fileID: 11500000, guid: 4bf5c202f9dd7a440a77a062fe161f4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Protostar.UI::ActionBindingText
  textMesh: {fileID: 1396422763}
  message: "You are a child made of stardust living in a strange and massive city
    of wonders. You are currently standing in your living quarters. That much you
    know.\r\n\r\nYour mentor, a creator and traveler of worlds, has tasked you with
    finishing one of their unfinished world concepts for them while they are out
    and about. (You are carrying it right now in your backpack.) \r\n\r\nThe first
    step to creating a world is the spark of potential. Maybe you can find it in
    your creation pod! \r\n\r\nUse {Move} to move and {Jump} to jump."
